# --- required -------------------------------------------------------------
# Postgres connection string. Neon, Supabase, Railway Postgres, anything.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Session signing key. MUST be 32+ chars and unique per environment.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

# Public origin, no trailing slash. Share links and API docs are built from it.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# --- storage --------------------------------------------------------------
# Pick ONE of the two blocks below.
#
# 1. OBJECT STORAGE (production). Set S3_BUCKET and the app uses S3-compatible
#    storage instead of the disk. Required on any serverless host (Vercel,
#    Netlify, Lambda) where the filesystem is wiped between requests.
#    For Cloudflare R2 the endpoint is https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# 2. LOCAL DISK (development, or a host with a real mounted volume).
#    Used whenever S3_BUCKET is empty. On a host with ephemeral storage this
#    must point at a mounted volume, or uploads and reports are lost.
STORAGE_DIR="./storage"

# --- optional -------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Veritas Reports"
SUBMISSION_PROVIDER="manual"

# Read only by prisma/seed.ts when creating the first admin.
ADMIN_EMAIL="you@your-domain.com"
ADMIN_PASSWORD=""
